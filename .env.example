# انسخ هذا الملف إلى .env على السيرفر فقط. لا يُرفع .env إلى Git أبداً.
# كل المتغيرات اختيارية: الموقع يعمل بدونها، وكل متغير يفعّل ميزة واحدة.

# --- العرض العام للشحنة من رمز QR (/api/public-shipment?id=...) ---
# مفتاح service_role من Supabase ← Project Settings ← API. يبقى على الخادم فقط.
SUPABASE_URL=https://vthcmqqiexaedukduquv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- توليد PDF لفاتورة بحر سواكن (/api/render-bsgt-pdf) ---
# يُولَّد محلياً بـ Chromium داخل الحاوية. اضبط BROWSERLESS_TOKEN فقط إن أردت
# العودة لخدمة Browserless كما كان على Vercel.
BROWSERLESS_TOKEN=
BROWSERLESS_PDF_ENDPOINT=

# --- حماية تسجيل الدخول (/api/login-security) ---
# أنشئ Turnstile Widget للنطاق jahez.swaken.net ثم ضع المفاتيح هنا على الخادم.
# المفتاح السري لا يرسل إلى المتصفح. المفتاح العام يعرضه مسار الإعدادات فقط.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=jahez.swaken.net
# يفضّل المفتاح العام محدود الصلاحية. يستخدم الخادم SERVICE_ROLE كخيار احتياطي
# داخلي فقط إذا لم تتم إضافة هذا المتغير.
SUPABASE_ANON_KEY=

# --- ربط Word Online عبر Microsoft Graph (/api/microsoft) ---
# يلزم تسجيل عنوان إعادة التوجيه الجديد في Azure:
#   https://jahez.swaken.net/api/microsoft?action=callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
